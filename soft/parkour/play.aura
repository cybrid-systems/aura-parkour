; Interactive Soft play loop. stdin = INPUT lines from the C viewport.
; stdout = SNAP blocks (Soft owns score/death). C only blits + feeds keys.
; Play-mode helpers live here so world.aura stays smoke-compatible.
(load "soft/parkour/world.aura")
(load "soft/parkour/objects.aura")
(require "std/string" all:)

(define *play* 0)
(define *in-jump* 0)
(define *in-slide* 0)
(define *in-dz* 0)

(define (parkour:play-mode! on)
  (set! *play* on)
  *play*)

(define (parkour:feed! jump slide dz)
  (set! *in-jump* jump)
  (set! *in-slide* slide)
  (set! *in-dz* dz)
  (list *in-jump* *in-slide* *in-dz*))

(define (parkour:reset!)
  (set! *x* 0)
  (set! *y* 0)
  (set! *z* 0)
  (set! *vx* 1)
  (set! *vy* 0)
  (set! *vz* 0)
  (set! *state* 0)
  (set! *score* 0)
  (set! *alive* 1)
  (set! *obs* '())
  (set! *gen-x* 8)
  (set! *tick* 0)
  (set! *in-jump* 0)
  (set! *in-slide* 0)
  (set! *in-dz* 0)
  (parkour:refresh!)
  (ensure!)
  *tick*)

(define (player-intent)
  (if (= *play* 1)
      (cons *in-jump* *in-slide*)
      (intent)))

(define (apply-lane!)
  (if (= *play* 1)
      (begin
        (set! *z* (+ *z* *in-dz*))
        (if (< *z* -2) (set! *z* -2))
        (if (> *z* 2) (set! *z* 2)))))

; Score-owned sprint. Soft writes *vx*; the viewport only follows the snap.
; 0–23 → 2, then +1 every 24 points, capped at 5. M0 does not use this.
(define (parkour:pace)
  (cond ((>= *score* 72) 5)
        ((>= *score* 48) 4)
        ((>= *score* 24) 3)
        (#t 2)))

; Override integrate! for player input + lane (Soft still owns physics/score/death).
(define (integrate!)
  (let* ((it (player-intent))
         (do-slide (cdr it))
         (do-jump (if (= do-slide 0) (car it) 0)))
    (parkour:refresh!)
    (if (= *alive* 0)
        #f
        (begin
          (cond ((= do-slide 1)
                 (set! *state* 2)
                 (set! *vy* 0)
                 (set! *y* 0))
                ((and (= do-jump 1) (<= *y* 0))
                 (set! *state* 1)
                 (set! *vy* *jump-v*))
                ((<= *y* 0)
                 (set! *state* 0)
                 (set! *vy* 0))
                (#t (set! *state* 1)))
          (if (or (> *y* 0) (> *vy* 0))
              (begin
                (set! *vy* (- *vy* *grav*))
                (set! *y* (+ *y* *vy*))
                (if (< *y* 0)
                    (begin
                      (set! *y* 0)
                      (set! *vy* 0)
                      (if (= *state* 1) (set! *state* 0))))))
          (set! *vx* (parkour:pace))
          (set! *x* (+ *x* *vx*))
          (apply-lane!)
          (set! *score* (+ *score* (touch-coins)))
          (if (= (lethal?) 1)
              (begin (set! *alive* 0) (set! *state* 3))
              (set! *score* (+ *score* 1)))))))

; Snapshot always includes Soft SCORE for the C HUD.
(define (parkour:snapshot-text)
  (parkour:refresh!)
  (string-append
    "SNAP v1\n"
    "SCALAR gravity=" (number->string *grav*)
    " jump_v=" (number->string *jump-v*)
    " slide_h=" (number->string *slide-h*) "\n"
    "PLAYER x=" (number->string *x*)
    " y=" (number->string *y*)
    " z=" (number->string *z*)
    " vx=" (number->string *vx*)
    " vy=" (number->string *vy*)
    " vz=" (number->string *vz*)
    " state=" (number->string *state*) "\n"
    "SCORE score=" (number->string *score*)
    " alive=" (number->string *alive*)
    " tick=" (number->string *tick*) "\n"
    "OBS n=" (number->string (count *obs*)) "\n"
    (emit-obs *obs*)
    "END\n"))

(define (nth-str xs i)
  (if (or (null? xs) (< i 0)) ""
      (if (= i 0) (car xs)
          (nth-str (cdr xs) (- i 1)))))

(define (as-int s)
  (if (not (string? s)) 0
      (let ((n (string->number s)))
        (if (number? n) n 0))))

; INPUT jump slide dz quit restart
(define (handle-line! line)
  (let ((parts (string-split line " ")))
    (if (or (null? parts) (not (string=? (car parts) "INPUT")))
        (list 0 0)
        (let ((jump (as-int (nth-str parts 1)))
              (slide (as-int (nth-str parts 2)))
              (dz (as-int (nth-str parts 3)))
              (quit (as-int (nth-str parts 4)))
              (restart (as-int (nth-str parts 5))))
          (cond ((= quit 1) (list 1 0))
                ((= restart 1)
                 (parkour:reset!)
                 (list 0 1))
                (#t
                 (parkour:feed! jump slide dz)
                 (if (= (parkour:alive) 1)
                     (parkour:tick!))
                 (list 0 0)))))))

(define (emit-snap!)
  (display (parkour:snapshot-text)))

(define (parkour:play!)
  (let ((seeded (parkour:seed!)))
    (if (not (parkour:seed-ok?))
        (begin
          (try (sh "echo PARKOUR_PLAY_SEED_FAIL >&2") (catch (e) 0))
          (error "parkour play seed failed"))
        (begin
          (parkour:play-mode! 1)
          (parkour:reset!)
          ; Authoritative world frame BEFORE any INPUT. Logs stay off stdout
          ; so the pipe is SNAP v1 ... END only.
          (emit-snap!)
          (try (sh "echo PARKOUR_PLAY_READY >&2") (catch (e) 0))
          (let loop ()
            (let ((line (read-line)))
              (if (not (string? line))
                  (begin (try (sh "echo PARKOUR_PLAY_EOF >&2") (catch (e) 0)) 0)
                  (begin
                    ; First INPUT may swap chunk-grammar from a DeepSeek
                    ; proposal. Score is not part of that proposal.
                    (parkour:maybe-propose!)
                    (let ((res (handle-line! line)))
                      (if (= (car res) 1)
                          (begin (try (sh "echo PARKOUR_PLAY_QUIT >&2") (catch (e) 0)) 0)
                          (begin
                            (emit-snap!)
                            (loop))))))))))))

(parkour:play!)
